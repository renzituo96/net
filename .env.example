# Supabase配置 - 部署到Vercel时需在Vercel Dashboard中设置这些环境变量
SUPABASE_URL=your_supabase_url_here  # 您的Supabase项目URL
SUPABASE_KEY=your_supabase_service_role_key_here  # 您的Supabase服务角色密钥

# 服务器配置
PORT=3000  # Vercel会自动处理端口，此值仅用于本地开发

# Vercel部署说明：
# 1. 在Vercel Dashboard中添加上述环境变量
# 2. 确保使用服务角色密钥(service_role)而不是 anon 密钥
# 3. 部署后，API端点将为 https://your-vercel-app.vercel.app/api/register